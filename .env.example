NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai-coach
POSTGRES_URL=postgresql://username:password@your-host.example:5432/ai-coach?sslmode=require
LEGACY_JSON_DB_PATH=.data/ai-coach.json
# Optional one-time local development bootstrap; do not commit real credentials.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
LLM_PROVIDER=inception
LLM_MODEL=mercury-3
EMBEDDING_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
EMBEDDING_TIMEOUT_MS=30000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Inception's Mercury API is scheduled to stop serving requests after 2026-12-28.
INCEPTION_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=30000
PRESIDIO_URL=http://127.0.0.1:5002
PRESIDIO_TIMEOUT_MS=60000
PRESIDIO_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
PRESIDIO_SPACY_MODEL=en_core_web_sm
PRESIDIO_PERSON_CONFIDENCE_THRESHOLD=0.6
# Optional; defaults to person_allowlist.json in the service working directory.
# PRESIDIO_PERSON_ALLOWLIST_PATH=person_allowlist.json
MAX_UPLOAD_BYTES=5242880
MAX_EXTRACTED_TEXT_CHARS=200000
MAX_PDF_PAGES=100
MAX_DOCX_ENTRIES=1000
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

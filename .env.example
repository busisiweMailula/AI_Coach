NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb://localhost:27017/ai-coach
MONGODB_DB_NAME=ai-coach
LLM_PROVIDER=inception
LLM_MODEL=mercury-3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Inception's Mercury API is scheduled to stop serving requests after 2026-12-28.
INCEPTION_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=30000
PRESIDIO_URL=http://127.0.0.1:5002
PRESIDIO_TIMEOUT_MS=60000
PRESIDIO_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
FILE_STORAGE_DIR=.data/uploads
MAX_UPLOAD_BYTES=5242880
MAX_EXTRACTED_TEXT_CHARS=200000
MAX_PDF_PAGES=100
MAX_DOCX_ENTRIES=1000
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
